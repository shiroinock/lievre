{
  "name": "lievre-tui-spike",
  "private": true,
  "type": "module",
  "description": "lievre の端末向けの試作の残り（操作できる見本、画面の書き出し、試しの書体）。部品は packages/tui に移した。公開しない。",
  "scripts": {
    "start": "tsx scripts/main.tsx",
    "capture": "tsx scripts/capture.tsx",
    "shot": "node scripts/shot.mjs",
    "font": "python3 -I font/build.py",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "tsx": "4.23.15"
  }
}
