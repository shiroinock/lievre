{
  "name": "@lievre/tui",
  "private": true,
  "type": "module",
  "description": "lievre（いまの KEI）の端末向けパッケージの試作。仮の名前で、公開しない。モノレポに移すまではリポジトリの直下の react と tokens/tokens.json を使う。",
  "scripts": {
    "start": "tsx src/ink/main.tsx",
    "capture": "tsx scripts/capture.tsx",
    "shot": "node scripts/shot.mjs",
    "font": "python3 -I font/build.py",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ink": "8.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "tsx": "4.23.15"
  }
}
