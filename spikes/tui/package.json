{
  "name": "kei-spike-tui",
  "private": true,
  "type": "module",
  "description": "KEI のデザイン言語を端末に広げる試作。本体には入れない。react はリポジトリの直下のものを使う。",
  "scripts": {
    "start": "tsx src/main.tsx",
    "capture": "tsx scripts/capture.tsx",
    "shot": "node scripts/shot.mjs",
    "font": "python3 -I font/build.py",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ink": "8.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "tsx": "4.23.15"
  }
}
