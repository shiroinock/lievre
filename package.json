{
  "name": "lievre",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/tokens",
    "packages/react",
    "packages/tui"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/react",
    "storybook": "npm run storybook -w packages/react",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node --test \"scripts/*.test.mjs\" && npm run test --workspaces --if-present",
    "test:layout": "npm run test:layout -w packages/react",
    "build": "npm run build --workspaces --if-present",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:overlap": "node scripts/check-overlap.mjs",
    "format": "prettier --write .",
    "tokens": "npm run tokens -w packages/tokens",
    "llms": "npm run llms -w packages/react",
    "wear": "npm run wear -w packages/react",
    "wear:font": "npm run wear:font -w packages/react",
    "wear:setup": "npm run wear:setup -w packages/react",
    "wear:tune": "npm run wear:tune -w packages/react",
    "bench:agent": "npm run bench:agent -w packages/react"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
