{
  "name": "lievre",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @lievre/react run dev",
    "storybook": "pnpm --filter @lievre/react run storybook",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "node --test \"scripts/*.test.mjs\" && pnpm -r --if-present run test",
    "test:layout": "pnpm --filter @lievre/react run test:layout",
    "build": "pnpm -r --if-present run build",
    "check:changelog": "node scripts/check-changelog.mjs",
    "changelog:release": "node scripts/changelog-release.mjs",
    "check:overlap": "node scripts/check-overlap.mjs",
    "format": "prettier --write .",
    "tokens": "pnpm --filter @lievre/tokens run tokens",
    "llms": "pnpm --filter @lievre/react run llms",
    "wear": "pnpm --filter @lievre/react run wear",
    "wear:font": "pnpm --filter @lievre/react run wear:font",
    "wear:setup": "pnpm --filter @lievre/react run wear:setup",
    "wear:tune": "pnpm --filter @lievre/react run wear:tune",
    "bench:agent": "pnpm --filter @lievre/react run bench:agent",
    "design-system": "node scripts/design-system/build.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=24.15"
  },
  "packageManager": "pnpm@12.21.0"
}
