// lievre/confirm-dialog-trigger: without `trigger` or `open`, nothing can open the dialog.
language js(typescript, jsx);

or {
  JsxOpeningElement(name = "ConfirmDialog", attributes = $attributes) as $dialog,
  JsxSelfClosingElement(name = "ConfirmDialog", attributes = $attributes) as $dialog
} where {
  $attributes <: not contains or { JsxAttribute(name = "trigger"), JsxAttribute(name = "open"), JsxSpreadAttribute() },
  $dialog <: within JsModule() as $module,
  $module <: contains `import $_ from "@lievre/react"`,
  register_diagnostic(span = $dialog, message = "ConfirmDialog に trigger も open もなく、開く手段がありません。ボタンから開くなら trigger を、メニューの項目などから開くなら open と onOpenChange を渡してください。")
}
