// lievre/dialog-close: `open` without `onOpenChange`, and a footer Button that does nothing.
language js(typescript, jsx);

or {
  or {
    JsxOpeningElement(name = $name, attributes = $attributes) as $element,
    JsxSelfClosingElement(name = $name, attributes = $attributes) as $element
  } where {
    $attributes <: contains JsxAttribute(name = "open") as $open,
    $attributes <: not contains or { JsxAttribute(name = "onOpenChange"), JsxSpreadAttribute() },
    $element <: within JsModule() as $module,
    $module <: contains `import $_ from "@lievre/react"`,
    or {
      and { $name <: "Dialog", register_diagnostic(span = $open, message = "Dialog に open だけを渡すと、Escape・閉じるボタン・外側を押しても閉じません。open と一緒に onOpenChange={setOpen} を渡してください。開閉を部品に任せるなら open を省きます。") },
      and { $name <: "ConfirmDialog", register_diagnostic(span = $open, message = "ConfirmDialog に open だけを渡すと、Escape・閉じるボタン・外側を押しても閉じません。open と一緒に onOpenChange={setOpen} を渡してください。開閉を部品に任せるなら open を省きます。") },
      and { $name <: "Popover", register_diagnostic(span = $open, message = "Popover に open だけを渡すと、Escape・閉じるボタン・外側を押しても閉じません。open と一緒に onOpenChange={setOpen} を渡してください。開閉を部品に任せるなら open を省きます。") }
    }
  },
  or {
    JsxOpeningElement(name = "Button", attributes = $attributes) as $button,
    JsxSelfClosingElement(name = "Button", attributes = $attributes) as $button
  } where {
    $attributes <: not contains or { JsxAttribute(name = "onClick"), JsxAttribute(name = "type"), JsxSpreadAttribute() },
    $button <: within JsxAttribute(name = "footer") as $footer,
    $footer <: within or { JsxOpeningElement(name = "Dialog"), JsxSelfClosingElement(name = "Dialog") },
    $button <: not within JsxElement(opening_element = JsxOpeningElement(name = "DialogClose")),
    $button <: within JsModule() as $module,
    $module <: contains `import $_ from "@lievre/react"`,
    register_diagnostic(span = $button, message = "Dialog の footer の Button に onClick がなく、押しても何も起きません。閉じるだけのボタンは <DialogClose asChild><Button>キャンセル</Button></DialogClose> で包み、処理するボタンには onClick を渡してください。")
  }
}
