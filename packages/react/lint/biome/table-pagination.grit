// lievre/table-pagination: a sortable DataTable paged by a Pagination beside it, not by DataTable.
// Only within one component: the nearest function around the DataTable must hold the Pagination.
// GritQL cannot follow `columns={columns}`, so any `sortValue` in the file makes the table sortable.
language js(typescript, jsx);

or {
  JsxOpeningElement(name = "DataTable", attributes = $attributes) as $table,
  JsxSelfClosingElement(name = "DataTable", attributes = $attributes) as $table
} where {
  $attributes <: not contains or { JsxAttribute(name = "pageSize"), JsxAttribute(name = "dataMode"), JsxSpreadAttribute() },
  $table <: within JsModule() as $module,
  $module <: contains `import $_ from "@lievre/react"`,
  $module <: contains or { JsPropertyObjectMember(name = "sortValue"), JsMethodObjectMember(name = "sortValue") },
  or {
    and {
      $table <: within or { JsArrowFunctionExpression(), JsFunctionDeclaration(), JsFunctionExportDefaultDeclaration(), JsFunctionExpression(), JsMethodObjectMember(), JsMethodClassMember() } as $owner,
      $owner <: contains or { JsxOpeningElement(name = "Pagination"), JsxSelfClosingElement(name = "Pagination") }
    },
    and {
      $table <: not within or { JsArrowFunctionExpression(), JsFunctionDeclaration(), JsFunctionExportDefaultDeclaration(), JsFunctionExpression(), JsMethodObjectMember(), JsMethodClassMember() },
      $module <: contains or { JsxOpeningElement(name = "Pagination"), JsxSelfClosingElement(name = "Pagination") }
    }
  },
  register_diagnostic(span = $table, message = "並べ替えのある DataTable の外で Pagination を使うと、区切った後の行の中だけで並べ替わります。全件を rows に渡して pageSize を付け、ページ送りは DataTable に描かせてください（pageSize={10} page={page} onPageChange={setPage}）。サーバーで並べ替えて区切るなら dataMode='server' と totalCount を渡してください。")
}
