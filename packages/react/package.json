{
  "name": "@lievre/react",
  "version": "0.2.0",
  "description": "lievre — 日本語の画面のための React の部品と CSS トークン",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/lievre.js"
    },
    "./styles.css": "./lib/lievre.css",
    "./fonts.css": "./lib/fonts.css",
    "./tokens.json": "./lib/tokens.json",
    "./llms.txt": "./llms.txt",
    "./lint": {
      "types": "./lint/index.d.ts",
      "default": "./lint/index.js"
    },
    "./lint/biome/*": "./lint/biome/*"
  },
  "bin": {
    "lievre-migrate": "./bin/lievre-migrate.mjs"
  },
  "files": [
    "lib",
    "bin",
    "llms.txt",
    "lint",
    "README.md",
    "DESIGN.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build:storybook": "storybook build -o dist/storybook --disable-telemetry",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && cp src/wear/age.d.mts src/wear/presets.d.mts lib/wear/ && cp ../tokens/tokens.json lib/tokens.json && cp src/styles/fonts.css lib/fonts.css",
    "check:pack": "node scripts/check-pack.mjs",
    "build": "npm run typecheck && npm run lint && npm run wear && npm run build:lib && npm run build:demo && npm run build:storybook",
    "typecheck": "tsc --noEmit",
    "lint": "stylelint \"src/**/*.css\" && stylelint --config stylelint.config.mjs ../tokens/tokens.css && eslint .",
    "test": "vitest run",
    "test:layout": "vitest run -c vitest.layout.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "wear": "node scripts/build-wear.mjs",
    "wear:font": "node scripts/build-wear-font.mjs",
    "wear:setup": "node scripts/wear/setup.mjs",
    "wear:tune": "vite --open /tune.html",
    "llms": "node scripts/build-llms.mjs",
    "bench:agent": "npm run build:lib && node bench/agent/misuse.mjs && node bench/agent/context.mjs",
    "prepack": "cp ../../DESIGN.md ../../MIGRATION.md .",
    "postpack": "rm DESIGN.md MIGRATION.md"
  },
  "peerDependencies": {
    "@lievre/fonts": "^0.1.1",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@lievre/fonts": {
      "optional": true
    }
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "downshift": "9.5.0",
    "lucide-react": "^1.0.0",
    "radix-ui": "1.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "@lievre/fonts": "https://github.com/shiroinock/lievre-fonts/releases/download/v0.1.1/lievre-fonts-0.1.1.tgz",
    "@lievre/tokens": "0.2.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "^4.1.12",
    "axe-core": "^4.11.0",
    "eslint": "^10.13.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "10.6.7",
    "stylelint": "^17.16.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
